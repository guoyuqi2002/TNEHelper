# Root .gitignore for the portfolio repository

# dependencies
node_modules/
vendor/

# build artifacts
dist/
build/bin/
*.exe

# runtime data (task state, downloaded attachments, databases, cookies)
tne-helper-data/
*.db
*.db-shm
*.db-wal
cookies*.json

# environment files with real credentials
.env

# misc
.DS_Store
*.log
