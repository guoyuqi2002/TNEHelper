# Example environment configuration for the TNE Assistant desktop app.
# Copy to .env (or export in your shell) and fill in real values.
# Never commit real credentials.

# Baidu AI OCR credentials (required for invoice recognition).
# API key created in the Baidu AI Cloud console; the name is a label you assign
# to the key and is only used for bookkeeping.
BAIDU_OCR_API_KEY=
BAIDU_OCR_API_NAME=

# Workday tenant URLs (required for browser automation).
# HOME is the tenant landing page you log in to.
# TASK is the Workday task/report used to look up expense-report attachments.
WORKDAY_HOME_URL=https://www.myworkday.com/YOUR_TENANT/d/home.htmld
WORKDAY_TASK_URL=https://www.myworkday.com/YOUR_TENANT/d/task/YOUR_TASK.htmld

# Optional: keyword used to classify unmatched VAT invoices by buyer name.
#KNOWN_PURCHASER_KEYWORD=YOUR_COMPANY_NAME
